# Copy this file to .env and adjust. Values set in your shell override it.
# These match docker-compose.yml.

PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=benchmark
# Set to true for hosted databases such as AWS RDS
PGSSL=false
# Set to false to run the servers without Postgres
PG_CONNECT=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set to true to use the local Redis Cluster created by redis.sh (ports 7000+)
REDIS_CLUSTER=false
